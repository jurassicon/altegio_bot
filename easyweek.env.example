# Скопируйте этот файл в easyweek.env перед настройкой EasyWeek:
#   cp easyweek.env.example easyweek.env
# easyweek.env добавлен в .gitignore. Никогда не коммитьте в него реальные
# секреты вебхуков — и не кладите реальный секрет в этот .example.
# Файл читает только сервис altegio-api (env_file с required: false), поэтому
# его отсутствие на сервере не ломает деплой.

# Мастер-флаг поверхности. false — POST /webhooks/easyweek отвечает 404.
EASYWEEK_ENABLED=false

# Общий секрет из ?token= в URL вебхука. Пустое значение держит эндпоинт
# закрытым (403) даже при EASYWEEK_ENABLED=true — fail-closed.
# Сгенерировать: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
EASYWEEK_WEBHOOK_SECRET=
