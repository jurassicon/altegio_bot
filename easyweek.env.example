# Скопируйте этот файл в easyweek.env перед настройкой EasyWeek:
#   cp easyweek.env.example easyweek.env
# easyweek.env добавлен в .gitignore. Никогда не коммитьте в него реальные
# секреты вебхуков — и не кладите реальный секрет в этот .example.
# Файл читают ТРИ сервиса — altegio-api, altegio-easyweek-inbox-worker и
# altegio-outbox-worker (env_file с required: false), поэтому его отсутствие на
# сервере не ломает деплой. Compose отдаёт файл целиком; selective
# interpolation не используется.
#
# ВНИМАНИЕ: `docker compose restart` НЕ перечитывает env_file. После правки
# любого флага нужен `up -d --force-recreate <сервис>`.
#
# Какой сервис пересоздавать после правки:
#
#   EASYWEEK_ENABLED, EASYWEEK_WEBHOOK_SECRET
#       -> altegio-api
#   EASYWEEK_PROCESSING_ENABLED, EASYWEEK_LOCATION_MAP,
#   EASYWEEK_INBOX_WORKER_POLL_SEC, EASYWEEK_NOTIFICATIONS_ENABLED,
#   EASYWEEK_ALLOWED_SERVICE_CATEGORIES, EASYWEEK_REMINDERS_ENABLED
#       -> altegio-easyweek-inbox-worker
#   EASYWEEK_LOCATION_MAP, EASYWEEK_BOOKING_PAGE_ALLOWED_HOSTS,
#   EASYWEEK_DEFAULT_LANGUAGE, EASYWEEK_ALLOWED_SERVICE_CATEGORIES,
#   EASYWEEK_REMINDER_API_GUARD_ENABLED, EASYWEEK_API_KEY,
#   EASYWEEK_WORKSPACE_SLUG
#       -> altegio-outbox-worker
#   EASYWEEK_API_KEY, EASYWEEK_WORKSPACE_SLUG, EASYWEEK_API_BASE_URL
#       -> только тот сервис/команда, где реально запускается probe

# Мастер-флаг поверхности. false — POST /webhooks/easyweek отвечает 404.
EASYWEEK_ENABLED=false

# Общий секрет из ?token= в URL вебхука. Пустое значение держит эндпоинт
# закрытым (403) даже при EASYWEEK_ENABLED=true — fail-closed.
# Сгенерировать: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
EASYWEEK_WEBHOOK_SECRET=

# --- PR-2: read-only Public API v2 (клиент + операторская проба) -------------
# Bearer-ключ Public API v2: Settings → Developers → API keys.
# Никогда не коммитьте реальный ключ — ни сюда, ни в easyweek.env.
EASYWEEK_API_KEY=

# Значение обязательного заголовка `Workspace` (slug воркспейса).
EASYWEEK_WORKSPACE_SLUG=

# Pinned base URL публичного API. Менять только если EasyWeek сменит версию.
EASYWEEK_API_BASE_URL=https://my.easyweek.io/api/public/v2

# --- PR-4: normalizer / easyweek_inbox_worker -------------------------------
# ТРИ независимых флага. EASYWEEK_ENABLED выше управляет ТОЛЬКО публичным
# capture-эндпоинтом; выключение обработки никогда не выключает capture.
#
# Обработка захваченных событий: claim + нормализация. Отдельный флаг нужен
# потому, что в production EASYWEEK_ENABLED уже true ради capture — воркер,
# гейтящийся тем же флагом, начал бы разбирать весь накопленный backlog сразу
# после деплоя PR-4.
EASYWEEK_PROCESSING_ENABLED=false

# Создание EasyWeek MessageJob. Production-дефолт остаётся false до PR-6:
# при false нормализация обновляет Client/Record, но очередь не наполняет.
EASYWEEK_NOTIFICATIONS_ENABLED=false

# --- PR-8: reminders -------------------------------------------------------
# Два независимых флага, оба fail-closed, и они включаются НЕ одновременно.
#
# EASYWEEK_REMINDERS_ENABLED управляет ТОЛЬКО созданием новых reminder jobs и
# читается easyweek inbox worker. Планирование дополнительно требует
# EASYWEEK_NOTIFICATIONS_ENABLED=true: reminder — это клиентское уведомление, и
# мастер-флаг нельзя обойти вторым флагом.
EASYWEEK_REMINDERS_ENABLED=false

# EASYWEEK_REMINDER_API_GUARD_ENABLED — это SEND FENCE, читается общим outbox
# worker. При false EasyWeek reminder jobs вообще не claim'ятся: они остаются
# queued, не тратят attempts и сохраняют исходный run_at. Это НЕ способ
# отправлять без guard: при true guard всё равно обязателен перед каждым Meta
# attempt. Режима «отправить reminder без проверки API» не существует.
#
# Порядок rollout: planning=true при guard=false → накопить реальные jobs →
# read-only preflight → и только при зелёном preflight guard=true.
EASYWEEK_REMINDER_API_GUARD_ENABLED=false

# Точный JSON-массив разрешённых root-level service_category. Пустой массив,
# пустая строка или невалидный JSON ничего не разрешают. Сравнение выполняется
# после Unicode/whitespace/case normalization, но только по полному равенству:
# service_name, services_description и service_id не используются.
# Production после контролируемого rollout:
# EASYWEEK_ALLOWED_SERVICE_CATEGORIES=["Wimpernverlängerung"]
EASYWEEK_ALLOWED_SERVICE_CATEGORIES=[]

# Строгий JSON-реестр филиалов. Верхний ключ — стабильное операторское имя.
# Каждая запись несёт numeric location_id (= provider-scoped company_id), UUID
# из того же филиала, префикс одобренных Meta-шаблонов и СВОЮ страницу записи.
# Лишнее/пропущенное поле, duplicate key, невалидный JSON или пустая карта
# держат обработку выключенной (fail-closed). Формат с полностью тестовыми
# значениями:
# EASYWEEK_LOCATION_MAP={"example-branch":{"location_id":999001,"location_uuid":"aaaaaaaa-bbbb-4ccc-8ddd-eeeeeeeeeeee","meta_template_prefix":"xx","booking_page_url":"https://booking.example.invalid/example"}}
EASYWEEK_LOCATION_MAP={}

# Интервал опроса очереди захвата, секунды (0.05–60.0).
EASYWEEK_INBOX_WORKER_POLL_SEC=1.0

# --- PR-5: outbox rendering --------------------------------------------------
# Статическая страница записи каждой локации задаётся в карте выше и используется
# как безопасный fallback,
# когда per-booking manage link не удаётся ПОВТОРНО подтвердить на send-time, и
# ВСЕГДА для record_canceled: отменённая запись должна вести к новой записи, а
# не к управлению уже отменённой.
#
# Валидируется на send-time (не на старте процесса — иначе EasyWeek-опечатка
# уронила бы общий outbox-воркер вместе со всем Altegio-трафиком). Требования:
# абсолютный URL, только https, обязательный hostname, без credentials, без
# fragment, без control-символов.
#
# Пусто или невалидно = не сконфигурировано: lifecycle-job упадёт локально, до
# вызова Meta, а не отправит сообщение с пустой или подменённой ссылкой.
# Хосты, на которые booking_page_url из реестра имеет право указывать
# (через запятую). ПУСТО = отвергается ВСЁ, а не разрешается всё: пока
# approved-хост не подтверждён, опечатка в URL выше иначе прошла бы все
# синтаксические проверки и уехала клиенту как ссылка после отмены.
# Fail-closed останавливает активацию вместо этого.
EASYWEEK_BOOKING_PAGE_ALLOWED_HOSTS=

# Язык, на котором ищутся EasyWeek message_templates. Отдельно от Altegio-карты
# языков по company_id: у EasyWeek своя локация и свои утверждённые шаблоны.
EASYWEEK_DEFAULT_LANGUAGE=de
