# Скопируйте этот файл в easyweek.env перед настройкой EasyWeek:
#   cp easyweek.env.example easyweek.env
# easyweek.env добавлен в .gitignore. Никогда не коммитьте в него реальные
# секреты вебхуков — и не кладите реальный секрет в этот .example.
# Файл читают ТРИ сервиса — altegio-api, altegio-easyweek-inbox-worker и
# altegio-outbox-worker (env_file с required: false), поэтому его отсутствие на
# сервере не ломает деплой. Compose отдаёт файл целиком; selective
# interpolation не используется.
#
# ВНИМАНИЕ: `docker compose restart` НЕ перечитывает env_file. После правки
# любого флага нужен `up -d --force-recreate <сервис>`.
#
# Какой сервис пересоздавать после правки:
#
#   ВНИМАНИЕ, читайте этот пункт первым:
#   EASYWEEK_NOTIFICATIONS_ENABLED
#       -> ОБА сервиса, altegio-easyweek-inbox-worker И altegio-outbox-worker.
#          Пересоздать только один из них НЕДОСТАТОЧНО.
#
#          С PR-12 мастер-флаг читают два long-running сервиса, и читают его
#          ПО-РАЗНОМУ:
#            inbox-worker  — ПЛАНИРОВАНИЕ: при false не создаются новые
#                            EasyWeek jobs НИ ОДНОГО типа;
#            outbox-worker — SEND только для PR-12 retention: при false не
#                            claim'ятся и не отправляются repeat_10d /
#                            comeback_3d, И БОЛЬШЕ НИЧЕГО.
#
#          Это НЕ глобальный send fence. Уже созданные EasyWeek lifecycle,
#          reminder_24h / reminder_2h и review_3d подчиняются своим собственным
#          send-time контрактам и могут быть отправлены при закрытом
#          мастер-флаге. Altegio он не затрагивает вообще.
#
#          Если выставить EASYWEEK_NOTIFICATIONS_ENABLED=false и пересоздать
#          только inbox-worker, outbox-worker останется с прежним
#          runtime-значением true и продолжит отправлять клиентам уже
#          накопленные retention jobs — то есть остановки retention, которой
#          не произошло.
#
#          ВЫКЛЮЧЕНИЕ. Порядок задаётся НЕ аргументами одной Compose-команды:
#          `up -d --force-recreate A B` упорядочивает сервисы по dependency
#          graph, а эти два worker'а друг от друга не зависят и могут
#          пересоздаваться параллельно. Нужны ОТДЕЛЬНЫЕ последовательные
#          команды: сначала force-recreate altegio-outbox-worker (он
#          отправляет), затем read-only проверка notifications == false ВНУТРИ
#          outbox-worker, и только после неё force-recreate
#          altegio-easyweek-inbox-worker. Если проверка не вернула false —
#          остановиться и не считать retention sends остановленными.
#          Полная последовательность — раздел 16.1 runbook.
#
#          Что даёт эта последовательность: остановку PR-12 retention sends и
#          нового EasyWeek planning. Чего она НЕ даёт: остановки уже
#          существующей EasyWeek очереди — lifecycle, reminders и review уйдут
#          по своим фенсам. Полная аварийная остановка всех отправок — это
#          hard-stop из раздела 8.2 runbook, а не этот флаг.
#
#          ВКЛЮЧЕНИЕ — не зеркало выключения. Открытие мастер-флага само по
#          себе ничего не разрешает: retention остаётся за своими
#          EASYWEEK_RETENTION_ENABLED / EASYWEEK_RETENTION_SEND_ENABLED, и
#          порядок включения — это preflight и canary из раздела 16.2.
#          Универсального правила «всегда outbox первым» не существует.
#
#   EASYWEEK_ENABLED, EASYWEEK_WEBHOOK_SECRET
#       -> altegio-api
#   EASYWEEK_PROCESSING_ENABLED, EASYWEEK_LOCATION_MAP,
#   EASYWEEK_INBOX_WORKER_POLL_SEC,
#   EASYWEEK_ALLOWED_SERVICE_CATEGORIES, EASYWEEK_REMINDERS_ENABLED,
#   EASYWEEK_REVIEWS_ENABLED, EASYWEEK_VISIT_COUNTER_ENABLED,
#   EASYWEEK_RETENTION_ENABLED
#       -> altegio-easyweek-inbox-worker
#   EASYWEEK_LOCATION_MAP, EASYWEEK_BOOKING_PAGE_ALLOWED_HOSTS,
#   EASYWEEK_DEFAULT_LANGUAGE, EASYWEEK_ALLOWED_SERVICE_CATEGORIES,
#   EASYWEEK_REMINDER_API_GUARD_ENABLED, EASYWEEK_REVIEW_SEND_ENABLED,
#   EASYWEEK_RETENTION_SEND_ENABLED, EASYWEEK_RETENTION_CANARY_JOB_ID,
#   EASYWEEK_API_KEY, EASYWEEK_WORKSPACE_SLUG
#       -> altegio-outbox-worker
#   EASYWEEK_API_KEY, EASYWEEK_WORKSPACE_SLUG, EASYWEEK_API_BASE_URL
#       -> только тот сервис/команда, где реально запускается probe

# Мастер-флаг поверхности. false — POST /webhooks/easyweek отвечает 404.
EASYWEEK_ENABLED=false

# Общий секрет из ?token= в URL вебхука. Пустое значение держит эндпоинт
# закрытым (403) даже при EASYWEEK_ENABLED=true — fail-closed.
# Сгенерировать: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
EASYWEEK_WEBHOOK_SECRET=

# --- PR-2: read-only Public API v2 (клиент + операторская проба) -------------
# Bearer-ключ Public API v2: Settings → Developers → API keys.
# Никогда не коммитьте реальный ключ — ни сюда, ни в easyweek.env.
EASYWEEK_API_KEY=

# Значение обязательного заголовка `Workspace` (slug воркспейса).
EASYWEEK_WORKSPACE_SLUG=

# Pinned base URL публичного API. Менять только если EasyWeek сменит версию.
EASYWEEK_API_BASE_URL=https://my.easyweek.io/api/public/v2

# --- PR-4: normalizer / easyweek_inbox_worker -------------------------------
# ТРИ независимых флага. EASYWEEK_ENABLED выше управляет ТОЛЬКО публичным
# capture-эндпоинтом; выключение обработки никогда не выключает capture.
#
# Обработка захваченных событий: claim + нормализация. Отдельный флаг нужен
# потому, что в production EASYWEEK_ENABLED уже true ради capture — воркер,
# гейтящийся тем же флагом, начал бы разбирать весь накопленный backlog сразу
# после деплоя PR-4.
EASYWEEK_PROCESSING_ENABLED=false

# Создание EasyWeek MessageJob. Production-дефолт остаётся false до PR-6:
# при false нормализация обновляет Client/Record, но очередь не наполняет.
#
# Мастер-флаг клиентских сообщений, и с PR-12 его читают ДВА long-running
# сервиса:
#   altegio-easyweek-inbox-worker — блокирует планирование;
#   altegio-outbox-worker         — блокирует claim и отправку уже созданных
#                                   repeat_10d / comeback_3d jobs.
# Поэтому любое изменение этого флага требует force-recreate ОБОИХ сервисов.
# Выключение — отдельными последовательными командами с проверкой между ними
# (раздел 16.1 runbook); включение идёт своим путём через fences, preflight и
# canary (раздел 16.2). Подробности — в шапке этого файла.
#
# Send-side флаг узкий: он закрывает ТОЛЬКО retention. Уже созданные lifecycle,
# reminders и review отправляются по своим контрактам, поэтому выключение этого
# флага не является аварийной остановкой EasyWeek — для неё есть §8.2 runbook.
EASYWEEK_NOTIFICATIONS_ENABLED=false

# --- PR-9: review_3d -------------------------------------------------------
# Two more independent gates, both fail-closed, and — like PR-8 — turned on at
# different points in the rollout.
#
# EASYWEEK_REVIEWS_ENABLED управляет ТОЛЬКО планированием
# booking-succeeded -> review_3d, и в runtime его читает единственный
# long-running сервис altegio-easyweek-inbox-worker.
# Планирование дополнительно требует EASYWEEK_NOTIFICATIONS_ENABLED=true:
# отзыв — это клиентское уведомление, и мастер-флаг вторым флагом не обходится.
#
# При выключенном планировании booking-succeeded НЕ уничтожается: событие
# остаётся `captured` и не блокирует последующие lifecycle events той же
# booking.
EASYWEEK_REVIEWS_ENABLED=false

# EASYWEEK_REVIEW_SEND_ENABLED — это ТОЛЬКО send fence, в runtime его читает
# общий long-running altegio-outbox-worker. При false review jobs вообще не
# claim'ятся: остаются `queued`, не тратят attempts, сохраняют run_at и не
# создают Outbox.
#
# Порядок rollout: planning=true при send=false -> накопить реальные jobs ->
# read-only `python -m altegio_bot.scripts.easyweek_review_preflight` ->
# и только при exit code 0 и ready=true открыть send fence.
#
# Закрытие fence НЕ отменяет уже созданные jobs; выключение planning НЕ
# открывает fence. Это независимые переключатели.
EASYWEEK_REVIEW_SEND_ENABLED=false

# Разделение владения выше — про RUNTIME. Один процесс читает ОБА флага сразу:
# one-off review preflight. Он создаётся из сервиса altegio-outbox-worker
# командой `run --rm --no-deps`, и ему нужны effective значения всех трёх —
# EASYWEEK_NOTIFICATIONS_ENABLED, EASYWEEK_REVIEWS_ENABLED и
# EASYWEEK_REVIEW_SEND_ENABLED: зелёный отчёт означает «notifications on,
# planning on, fence ещё закрыт», и каждое из этих условий он проверяет сам.
#
# Поэтому «EASYWEEK_REVIEWS_ENABLED вообще не читается ничем на базе outbox
# service» — неверно. Runtime worker не использует его при отправке; one-off
# preflight обязан его видеть.
#
# Отсюда практическое следствие: после изменения EASYWEEK_REVIEWS_ENABLED
# preflight нельзя запускать через `docker compose exec` в работающем
# altegio-outbox-worker. Тот контейнер создан со старым окружением и вернёт
# config_error `review_planning_disabled`. Нужен свежий one-off контейнер;
# точная команда — шаг 8 раздела 13.2 runbook.

# --- PR-11: visits_total / счётчик завершённых визитов -----------------------
# EASYWEEK_VISIT_COUNTER_ENABLED управляет ТОЛЬКО сохранением снимка
# `visits_total` из доказанного booking-succeeded на строку клиента EasyWeek.
# В runtime его читает единственный long-running сервис
# altegio-easyweek-inbox-worker. Общий altegio-outbox-worker его не читает:
# счётчик ничего не отправляет.
#
# Это НЕ notification fence и он намеренно НЕ требует
# EASYWEEK_NOTIFICATIONS_ENABLED. Счётчик не пишет клиенту — он фиксирует факт
# визита, который EasyWeek уже подтвердил. Если бы мастер-флаг его гасил, пауза
# в рассылке молча останавливала бы и доменный учёт, на который опирается
# PR-12 (repeat_10d / comeback_3d), а пропущенные снимки восстановить нечем:
# EasyWeek не переотправляет события, а `current + 1` доказательством не
# является.
#
# Значение — снимок, а не инкремент. Мы записываем число, которое назвал сам
# EasyWeek, поэтому Resend, повтор с другим payload hash и настоящий второй
# визит сходятся к одному значению, а не накручивают счётчик.
#
# Счётчик монотонен: меньшее значение не понижает уже сохранённое, равное —
# идемпотентный no-op без обновления timestamp.
#
# Rollback — это выключение флага, а не DELETE: уже доказанные значения
# остаются в БД. После изменения флага обычный `restart` НЕ перечитывает
# env_file, нужен `up -d --force-recreate altegio-easyweek-inbox-worker`.
EASYWEEK_VISIT_COUNTER_ENABLED=false

# --- PR-12: repeat_10d / comeback_3d ---------------------------------------
# Два независимых флага той же формы, что у PR-8 и PR-9, и включаются они в
# разные моменты rollout.
#
# EASYWEEK_RETENTION_ENABLED управляет ТОЛЬКО планированием двух сообщений —
# repeat_10d и comeback_3d, — и в runtime его читает единственный long-running
# сервис altegio-easyweek-inbox-worker. Планирование дополнительно требует
# EASYWEEK_NOTIFICATIONS_ENABLED=true: это клиентские сообщения, и мастер-флаг
# вторым флагом не обходится.
#
# Флаг НАМЕРЕННО узкий. Он разрешает ровно два типа job и ничего больше. Это не
# «маркетинговый» и не «campaign» переключатель: newsletters, newsletter
# follow-up, promo и campaign runner остаются Altegio-only, и общее имя дало бы
# будущему типу сообщений разрешение, которого никто не выдавал.
#
# repeat_10d планируется ТОЛЬКО из доказанного booking-succeeded и опирается на
# счётчик PR-11: baseline visits_total должен быть уже записан для этого визита,
# иначе job не создаётся (fail-closed, без подстановки нуля). Поэтому
# EASYWEEK_VISIT_COUNTER_ENABLED должен быть включён раньше.
#
# comeback_3d планируется ТОЛЬКО из доказанной отмены booking и хранит момент
# отмены в payload; повторные cancel/update-доставки дублей не создают.
EASYWEEK_RETENTION_ENABLED=false

# EASYWEEK_RETENTION_SEND_ENABLED — это ТОЛЬКО send fence, в runtime его читает
# общий long-running altegio-outbox-worker. При false EasyWeek retention jobs
# вообще не claim'ятся: остаются `queued`, не тратят attempts, сохраняют run_at
# и не создают Outbox. Fence проверяется ещё раз непосредственно перед
# обработкой, поэтому job, попавший в batch за миг до закрытия fence, вернётся
# в `queued` без расхода attempts.
#
# ВАЖНО: этот fence НЕ обходит мастер-флаг. При
# EASYWEEK_NOTIFICATIONS_ENABLED=false EasyWeek retention jobs не отправляются
# даже при EASYWEEK_RETENTION_SEND_ENABLED=true: уже созданная job — это всё ещё
# клиентское сообщение, и остановка retention обязана его останавливать.
# Мастер-флаг проверяется и при claim, и перед Meta.
#
# Обратное неверно: мастер-флаг закрывает send-side ТОЛЬКО у retention. Он не
# останавливает уже созданные lifecycle, reminders и review — это не аварийная
# остановка EasyWeek (§8.2 runbook).
#
# Altegio repeat_10d / comeback_3d этим fence НЕ управляются: предикат
# ограничен provider=easyweek. Совпадение имени типа — это ровно та коллизия,
# ради которой существует колонка provider.
#
# Порядок rollout: planning=true при send=false -> накопить реальные jobs ->
# read-only `python -m altegio_bot.scripts.easyweek_retention_preflight` ->
# и только при exit code 0 и ready=true открыть send fence.
#
# Закрытие fence НЕ отменяет уже созданные jobs; выключение planning НЕ
# открывает fence. Это независимые переключатели.
EASYWEEK_RETENTION_SEND_ENABLED=false

# Controlled canary: внутренний message_jobs.id ЕДИНСТВЕННОЙ EasyWeek retention
# job, которую worker имеет право claim'ить и отправлять, пока значение задано.
# В runtime читает altegio-outbox-worker.
#
# Пусто — ограничения нет, обычный bulk-режим.
# Положительное целое — только эта job. Остальные EasyWeek retention jobs
# остаются `queued` с теми же run_at, attempts=0 и locked_at=NULL.
# Любое другое значение (не число, ноль, отрицательное, мусор) — fail-closed:
# НИ ОДНА EasyWeek retention job не claim'ится, а preflight возвращает
# config_error `retention_canary_job_id_invalid`.
#
# Fail-closed на опечатке — это и есть смысл флага. Оператор, задавший его,
# решил, что уйдёт максимум одно сообщение; прочитать мусор как «ограничения
# нет» означало бы разослать всю очередь.
#
# Ограничение проверяется дважды — при claim и непосредственно перед Meta — и не
# затрагивает ни Altegio, ни другие типы EasyWeek jobs.
#
# Порядок canary: preflight при закрытом fence с заданным canary -> открыть
# fence -> одно сообщение -> закрыть fence -> убрать canary -> повторить
# preflight по всей очереди -> открыть bulk fence. Подробности — раздел 16.2
# runbook.
EASYWEEK_RETENTION_CANARY_JOB_ID=

# Разделение владения выше — про RUNTIME. Один процесс читает ОБА флага сразу:
# one-off retention preflight. Он создаётся из сервиса altegio-outbox-worker
# командой `run --rm --no-deps`, и ему нужны effective значения всех пяти —
# EASYWEEK_NOTIFICATIONS_ENABLED, EASYWEEK_VISIT_COUNTER_ENABLED,
# EASYWEEK_RETENTION_ENABLED, EASYWEEK_RETENTION_SEND_ENABLED и
# EASYWEEK_RETENTION_CANARY_JOB_ID: зелёный отчёт означает «notifications on,
# counter on, planning on, fence ещё закрыт», и каждое из этих условий он
# проверяет сам. При заданном canary он аудирует ровно эту одну job — тем же
# правилом, каким её ограничивает worker.
#
# Отсюда практическое следствие: после изменения EASYWEEK_RETENTION_ENABLED
# preflight нельзя запускать через `docker compose exec` в работающем
# altegio-outbox-worker. Тот контейнер создан со старым окружением и вернёт
# config_error `retention_planning_disabled`. Нужен свежий one-off контейнер;
# точная команда — шаг 8 раздела 16.2 runbook.

# --- PR-8: reminders -------------------------------------------------------
# Два независимых флага, оба fail-closed, и они включаются НЕ одновременно.
#
# EASYWEEK_REMINDERS_ENABLED управляет ТОЛЬКО созданием новых reminder jobs и
# читается easyweek inbox worker. Планирование дополнительно требует
# EASYWEEK_NOTIFICATIONS_ENABLED=true: reminder — это клиентское уведомление, и
# мастер-флаг нельзя обойти вторым флагом.
EASYWEEK_REMINDERS_ENABLED=false

# EASYWEEK_REMINDER_API_GUARD_ENABLED — это SEND FENCE, читается общим outbox
# worker. При false EasyWeek reminder jobs вообще не claim'ятся: они остаются
# queued, не тратят attempts и сохраняют исходный run_at. Это НЕ способ
# отправлять без guard: при true guard всё равно обязателен перед каждым Meta
# attempt. Режима «отправить reminder без проверки API» не существует.
#
# Порядок rollout: planning=true при guard=false → накопить реальные jobs →
# read-only preflight → и только при зелёном preflight guard=true.
EASYWEEK_REMINDER_API_GUARD_ENABLED=false

# Точный JSON-массив разрешённых root-level service_category. Пустой массив,
# пустая строка или невалидный JSON ничего не разрешают. Сравнение выполняется
# после Unicode/whitespace/case normalization, но только по полному равенству:
# service_name, services_description и service_id не используются.
# Production после контролируемого rollout:
# EASYWEEK_ALLOWED_SERVICE_CATEGORIES=["Wimpernverlängerung"]
EASYWEEK_ALLOWED_SERVICE_CATEGORIES=[]

# Строгий JSON-реестр филиалов. Верхний ключ — стабильное операторское имя.
# Каждая запись несёт numeric location_id (= provider-scoped company_id), UUID
# из того же филиала, префикс одобренных Meta-шаблонов и СВОЮ страницу записи.
# Лишнее/пропущенное поле, duplicate key, невалидный JSON или пустая карта
# держат обработку выключенной (fail-closed). Формат с полностью тестовыми
# значениями:
# EASYWEEK_LOCATION_MAP={"example-branch":{"location_id":999001,"location_uuid":"aaaaaaaa-bbbb-4ccc-8ddd-eeeeeeeeeeee","meta_template_prefix":"xx","booking_page_url":"https://booking.example.invalid/example"}}
EASYWEEK_LOCATION_MAP={}

# Интервал опроса очереди захвата, секунды (0.05–60.0).
EASYWEEK_INBOX_WORKER_POLL_SEC=1.0

# --- PR-5: outbox rendering --------------------------------------------------
# Статическая страница записи каждой локации задаётся в карте выше и используется
# как безопасный fallback,
# когда per-booking manage link не удаётся ПОВТОРНО подтвердить на send-time, и
# ВСЕГДА для record_canceled: отменённая запись должна вести к новой записи, а
# не к управлению уже отменённой.
#
# Валидируется на send-time (не на старте процесса — иначе EasyWeek-опечатка
# уронила бы общий outbox-воркер вместе со всем Altegio-трафиком). Требования:
# абсолютный URL, только https, обязательный hostname, без credentials, без
# fragment, без control-символов.
#
# Пусто или невалидно = не сконфигурировано: lifecycle-job упадёт локально, до
# вызова Meta, а не отправит сообщение с пустой или подменённой ссылкой.
# Хосты, на которые booking_page_url из реестра имеет право указывать
# (через запятую). ПУСТО = отвергается ВСЁ, а не разрешается всё: пока
# approved-хост не подтверждён, опечатка в URL выше иначе прошла бы все
# синтаксические проверки и уехала клиенту как ссылка после отмены.
# Fail-closed останавливает активацию вместо этого.
EASYWEEK_BOOKING_PAGE_ALLOWED_HOSTS=

# Язык, на котором ищутся EasyWeek message_templates. Отдельно от Altegio-карты
# языков по company_id: у EasyWeek своя локация и свои утверждённые шаблоны.
EASYWEEK_DEFAULT_LANGUAGE=de

# --- PR-10: где мы берём ссылку отзыва -------------------------------------
# EasyWeek НЕ присылает review_url. Production-запись Durlach 6922 содержит 88
# корневых ключей, и такого поля среди них нет — поэтому PR-9 в production не
# создавал ни одной review job. Источник ссылки — эта карта, а не payload.
#
# JSON-объект: EasyWeek company_id (он же location_id) -> Google review link
# строго вида https://g.page/r/<token>/review. Другие формы Google-ссылок
# (search.google.com/local/writereview?placeid=...) требуют query и этим
# контрактом не поддерживаются.
#
# Парсер тотальный и fail-closed: невалидный JSON, не-объект, дубликат ключа,
# нечисловой company_id или непроходящая валидатор ссылка делают НЕВАЛИДНОЙ всю
# карту целиком. Частичный результат опаснее пустого: филиал с потерянной
# записью выглядел бы как «ссылка не настроена» и молча остался бы без отзывов.
#
# Отдельная переменная намеренно. Не поле EASYWEEK_LOCATION_MAP: тот реестр
# гейтит lifecycle и reminders целиком, и опечатка в ссылке отзыва обрушила бы
# подтверждения записи. Не GOOGLE_MAPS_REVIEW_LINKS: та карта принадлежит
# Altegio и ключуется Altegio company id, который живёт в общем целочисленном
# пространстве с EasyWeek location_id.
#
# Читают: altegio-easyweek-inbox-worker (планирование) и altegio-outbox-worker
# (повторная проверка перед каждым Meta attempt). `docker compose restart` НЕ
# перечитывает env_file — нужен `up -d --force-recreate` этих двух сервисов.
EASYWEEK_GOOGLE_REVIEW_LINKS={"<location_id>":"https://g.page/r/REPLACE_WITH_REAL_TOKEN/review"}
