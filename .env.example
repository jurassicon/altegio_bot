APP_NAME=altegio_bot
ENV=dev

# Perf logging: set to "true" to emit structured JSON perf logs for worker operations.
# Logs go to the "altegio_bot.perf" logger at INFO level.
# Off by default — zero overhead when not set.
PERF_LOGGING_ENABLED=false

POSTGRES_DB=altegio_bot
POSTGRES_USER=altegio
POSTGRES_PASSWORD=your_password_here

DATABASE_URL=postgresql+asyncpg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@postgres:5432/${POSTGRES_DB}

# query param "secret" из твоих логов вебхука
ALTEGIO_WEBHOOK_SECRET=***

WHATSAPP_PROVIDER=meta_cloud
ALLOW_REAL_SEND=1
STOP_WORKER_ON_TOKEN_EXPIRED=1

WHATSAPP_ACCESS_TOKEN=***
WHATSAPP_WEBHOOK_VERIFY_TOKEN=***
META_WA_PHONE_NUMBER_ID=***
META_WABA_ID=***
WHATSAPP_GRAPH_URL=https://graph.facebook.com
WHATSAPP_API_VERSION=v20.0

# Ops-cabinet access (at least one must be set, or leave both empty for dev)
# Token auth: curl -H "X-Ops-Token: secret" http://localhost:8000/ops/monitoring
OPS_TOKEN=
# Browser form login (recommended): set OPS_USER + OPS_PASS, then open /ops/ in a browser
OPS_USER=
OPS_PASS=
# Optional: separate secret for signing session cookies (defaults to OPS_PASS when empty)
OPS_SECRET=

# marketing_only = block only marketing jobs on opt-out; all = block all WA messages
WA_OPTOUT_POLICY=marketing_only

# Minutes after which a 'processing' job is considered stuck (default: 15)
OPS_STUCK_MINUTES=15

# Warn on monitoring page if failed outbox count exceeds this (default: 10)
OPS_FAILED_WARNING_THRESHOLD=10

# IANA timezone for local time display (default: Europe/Berlin)
OPS_LOCAL_TZ=Europe/Berlin

# Chatwoot integration (optional – leave disabled for Meta-direct mode)
# Set CHATWOOT_ENABLED=true and WHATSAPP_PROVIDER=chatwoot_hybrid to enable dual-write
CHATWOOT_ENABLED=false
# CHATWOOT_BASE_URL — base URL for backend-to-backend Chatwoot API calls.
#
# The public HTTPS URL is the safe fallback and works everywhere.
# For production Docker-to-Docker Chatwoot API calls, prefer an internal URL
# only after the Chatwoot container/network is reachable from altegio_bot
# containers (see docs/ops/chatwoot_internal_route.md):
#   1. attach app services to the Chatwoot network via the opt-in override
#      docker-compose.chatwoot-internal.yml;
#   2. verify DNS + HTTP probes from inside the app containers pass.
# Do NOT set CHATWOOT_BASE_URL=http://... until those probes pass.
# This setting never affects Chatwoot's own FRONTEND_URL — do not change that.
# Example after verification:
# CHATWOOT_BASE_URL=http://chatwoot_rails_1:3000
# or another verified stable alias on the shared Docker network.
CHATWOOT_BASE_URL=https://chatwoot.example.com

# Optional. Only for verified internal Docker Chatwoot API routes.
# Use this when CHATWOOT_BASE_URL points to internal HTTP Rails, for example:
#   CHATWOOT_BASE_URL=http://rails:3000
#   CHATWOOT_API_FORWARDED_PROTO=https
# Plain http://rails:3000 answers 301 redirect without X-Forwarded-Proto.
# Allowed values: https, http. Empty (default) — header is not sent and
# behaviour is unchanged. Invalid values are ignored with a warning.
# Do not switch to an internal route before the DNS/API probes pass
# (docs/ops/chatwoot_internal_route.md), and never change Chatwoot's own
# FRONTEND_URL for this.
CHATWOOT_API_FORWARDED_PROTO=

CHATWOOT_API_TOKEN=
CHATWOOT_ACCOUNT_ID=1
CHATWOOT_INBOX_ID=1
CHATWOOT_WEBHOOK_SECRET=

# Controls whether inbound WhatsApp replies include a visible text quote in Chatwoot body.
# fallback_only: use native Chatwoot reply UI when native metadata is available; add a
#   visible quote only in fallback cases — bot/automation targets without a native Chatwoot
#   id, cross-conversation targets, and missing targets.
# always: always include a visible body quote, even when native metadata is sent.
# See docs/ops/chatwoot_reply_context.md for when to switch to "always".
CHATWOOT_REPLY_CONTEXT_VISIBLE_QUOTE_MODE=fallback_only

# Operator relay: behaviour when the 24h Meta customer service window is closed.
# private_note_only (default) — blocks the Meta send and notifies the operator
#   via a Chatwoot private note. Safe: never risks Meta session rule violations.
# reopen_template — sends an approved Meta template to re-engage the customer.
#   Requires CHATWOOT_OPERATOR_REOPEN_TEMPLATE_NAME to be set.
CHATWOOT_OPERATOR_RELAY_ENABLED=false
CHATWOOT_OPERATOR_CLOSED_WINDOW_MODE=private_note_only
CHATWOOT_OPERATOR_REOPEN_TEMPLATE_NAME=
CHATWOOT_OPERATOR_REOPEN_TEMPLATE_LANGUAGE=de
# none         — for templates with no body variables (smoke-test before enabling)
# contact_name — passes the contact's display name as the first body variable
CHATWOOT_OPERATOR_REOPEN_TEMPLATE_PARAM_MODE=contact_name
CHATWOOT_OPERATOR_REOPEN_PRIVATE_NOTE_ENABLED=true
# Provider-scoped JSON mapping Chatwoot branch inbox_id -> tenant identity.
# CHATWOOT_INBOX_ID above is the separate General / Unassigned inbox and MUST
# NOT appear as a key in this branch map.
# Example: CHATWOOT_INBOX_COMPANY_MAP={"8":{"provider":"altegio","company_id":758285},"7":{"provider":"altegio","company_id":1271200},"9":{"provider":"easyweek","company_id":308697}}
CHATWOOT_INBOX_COMPANY_MAP={}

# PR-7.2. Where a customer's inbound WhatsApp message is SHOWN, and whether an
# operator reply typed in the General inbox may resolve a branch sender.
# Exactly one of: context | affinity | general. An unknown value fails startup —
# a silent fallback would route customers to a branch nobody chose.
#
#   context  — default, today's behaviour. A proven reply/reaction context
#              decides; anything else is shown in General, and an operator reply
#              written in General stays blocked.
#   affinity — context still wins. Without it, the branch is resolved from the
#              customer's own proven history (last delivered/read notification,
#              then nearest future booking, then a single client identity).
#              Only genuine "nothing known" falls back to General; several
#              answers or contradictory data BLOCK instead of guessing.
#   general  — one-inbox display rollback: every customer inbound appears in
#              General. It does NOT relax the proof an operator reply needs
#              before a sender is chosen, and never means "pick the first
#              sender".
#
# Consumer: altegio-whatsapp-inbox-worker only. After changing this value
# recreate that one service (`up -d --force-recreate`); a plain restart does not
# re-read .env.
CHATWOOT_INBOUND_ROUTING_MODE=context

# PR-7.4. Single-inbox operator relay (production rollback to ONE inbox).
# The WhatsAppSender id an operator reply written in the General inbox may use
# when there is nothing to prove a branch with — a brand-new customer who wrote
# first has no booking, no client row and no prior delivery.
#
# 0 (default) — off. Every relay decision stays exactly as it is today.
#
# A positive value is honoured ONLY when ALL of the following hold, and fails
# closed otherwise:
#   * CHATWOOT_INBOX_COMPANY_MAP is unconfigured ("" or "{}");
#   * CHATWOOT_INBOUND_ROUTING_MODE=general;
#   * the reply was written in exactly CHATWOOT_INBOX_ID.
#
# The row is read by primary key and then proved: it must exist, be active,
# carry the same phone_number_id as the relay AND as META_WA_PHONE_NUMBER_ID,
# and hold a valid provider/company pair. It is never a search hint — no
# LIMIT 1, no min(id), no row order. Automatic MessageJob sends are untouched
# and keep their own provider-scoped sender selection. The 24h Meta customer
# service window is unchanged.
#
# Consumer: altegio-whatsapp-inbox-worker only. Recreate that one service
# (`up -d --force-recreate`) after changing it; a plain restart does not
# re-read .env. Put the real production id in .env, never here.
CHATWOOT_SINGLE_INBOX_OPERATOR_SENDER_ID=0

# Optional WhatsApp promo new-client check via Altegio visit history.
# Default false keeps local-only behaviour and makes no extra Altegio API call.
# If true, PROMO_LOCATION_ID_BY_COMPANY must map company_id to Altegio location_id.
PROMO_CHECK_NEW_CLIENT_IN_ALTEGIO=false
PROMO_LOCATION_ID_BY_COMPANY={"1":9001}

# Optional WhatsApp promo lead funnel.
# Default false sends a safe informational reply only and creates no PromoLead.
PROMO_LEAD_FUNNEL_ENABLED=false
PROMO_SECRET_WORDS=aktion,angebot,rabatt
PROMO_CAMPAIGN_NAME=welcome_discount
PROMO_LOYALTY_CARD_TYPE_ID=
PROMO_DISCOUNT_PROGRAM_ID=
PROMO_ISSUE_LOYALTY_CARD_ENABLED=false
PROMO_LOYALTY_CARD_API_VERIFIED=false
PROMO_ALTEGIO_CLIENT_API_VERIFIED=false

# Optional async WhatsApp promo eligibility flow.
# Default false keeps the current immediate MVP-1 reply flow.
# If true, a new promo keyword creates a pending_check lead and queues
# MessageJob(job_type='promo_eligibility_check') for the final decision.
PROMO_ASYNC_ELIGIBILITY_CHECK_ENABLED=false

# Optional automatic promo discount apply after Altegio record create webhook.
# Both gates must be true before the code can call the apply endpoint.
# Defaults are fail-closed; do not enable on production traffic before smoke.
PROMO_APPLY_DISCOUNT_ENABLED=false
PROMO_APPLY_DISCOUNT_API_VERIFIED=false
# Comma-separated Altegio service IDs eligible for automatic apply.
# Empty means automatic apply is skipped.
PROMO_ALLOWED_SERVICE_IDS=
# Apply implementation mode.
# record_price_override: PUT /record to change service price directly (confirmed working).
# Any other value falls back to the legacy loyalty-program endpoint (not used in production).
PROMO_APPLY_MODE=record_price_override

# Bot templates: send text inside open 24h WhatsApp customer window
# When enabled, selected bot notifications are sent as free-form text if the
# customer wrote within the last 24h. Otherwise templates are used as before.
# Recommended first rollout: disabled.
BOT_TEMPLATE_TEXT_INSIDE_24H_ENABLED=false
BOT_TEMPLATE_TEXT_INSIDE_24H_JOB_TYPES=record_created,record_updated,record_canceled,reminder_24h,reminder_2h
BOT_TEMPLATE_TEXT_INSIDE_24H_FALLBACK_ENABLED=true

# Worker polling intervals
# How long each worker sleeps (seconds) when no events/jobs are found.
# Lower values reduce queue pickup latency at the cost of more frequent DB polling.
# Recommended production values for current volume:
#   INBOX_WORKER_POLL_SEC=0.2
#   OUTBOX_WORKER_POLL_SEC=0.2
#   WHATSAPP_INBOX_WORKER_POLL_SEC=0.5
# Valid range: 0.05 – 60.0. Defaults are 1.0 s when unset.
INBOX_WORKER_POLL_SEC=1.0
OUTBOX_WORKER_POLL_SEC=1.0
WHATSAPP_INBOX_WORKER_POLL_SEC=1.0
